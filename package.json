{
  "name": "clipbraid",
  "version": "2.1.0",
  "private": true,
  "dependencies": {
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@mediabunny/ac3": "^1.58.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "lucide-react": "1.48.0",
    "mediabunny": "^1.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@ffmpeg/core": "0.12.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "mcp": "node mcp-server/index.js",
    "test:unit": "node --test --test-timeout=10000 tests/unit/*.test.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "fixtures:generate": "python3 scripts/generate-fixtures.py",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "test:production": "playwright test --config playwright.production.config.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:mcp": "tsc -p tsconfig.mcp.json && node --check mcp-server/index.js && node --check mcp-server/lib.js && node --check mcp-server/tools.js",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "check": "npm run check:toolchain && npm run typecheck && npm run check:mcp && npm run test:unit && npm run build && npm run check:style-isolation && npm run check:artifacts && npm run test:browser && npm run test:production",
    "check:style-isolation": "node scripts/check-style-isolation.mjs"
  },
  "type": "module",
  "engines": {
    "node": "22.23.3",
    "npm": "11.11.1"
  },
  "packageManager": "npm@11.11.1",
  "description": "ClipBraid \u2014 combine videos and photos with parallel audio and control over original video sound.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Denissvgn/ClipBraid.git"
  }
}
